/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://formspree.io; form-action https://formspree.io 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Demo builds are portfolio pieces for fictional brands. They must stay
# reachable but must not compete in search — they were pulling ~86% of all
# impressions for queries like "bloom candles" that can never convert.
# Do NOT add a robots.txt Disallow here: blocking the crawl would stop Google
# ever seeing the noindex, and the indexed URLs would linger indefinitely.
/demo/*
  X-Robots-Tag: noindex, follow
